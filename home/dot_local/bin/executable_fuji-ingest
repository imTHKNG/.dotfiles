#!/usr/bin/env bun
// Ingest every file from one PTP camera into a dated photography batch.
//
// gphoto2 copies the files; nothing on the camera is ever deleted. The script
// checks names and sizes against the camera listing, then writes SHA256SUMS.
// The .fuji-ingest.json manifest keeps the format of the earlier Python
// version, so a batch started by either version can be resumed by this one.

import type { Subprocess } from "bun";
import { createHash } from "node:crypto";
import * as fs from "node:fs";
import { homedir, tmpdir } from "node:os";
import { basename, dirname, extname, join, relative, resolve } from "node:path";
import { parseArgs } from "node:util";

const MANIFEST_NAME = ".fuji-ingest.json";
const CHECKSUM_NAME = "SHA256SUMS";
const CONTROL_NAMES = new Set([MANIFEST_NAME, `${MANIFEST_NAME}.tmp`, CHECKSUM_NAME, `${CHECKSUM_NAME}.tmp`]);
const SLUG_RE = /^[a-z0-9]+(?:-[a-z0-9]+)*$/;
const DATE_RE = /^(\d{4})-(\d{2})-(\d{2})$/;
const FILE_RE = /^#\d+\s+(.+?)\s+\S+\s+(\d+) KB(?:\s|$)/;
const FOLDER_RE = /^There (?:is|are).* folder '([^']+)'\./;
const SIZE_TOLERANCE_KIB = 1.5;
const POLL_MS = 200;
const USAGE = "usage: fuji-ingest [-h] [--date YYYY-MM-DD] [--root ROOT] [--dry-run] [--resume] slug";

type InventoryItem = { folder: string; name: string; size_kib: number };
type Manifest = Record<string, unknown>;
type Arguments = { slug: string; date: string; root: string; dryRun: boolean; resume: boolean };

class IngestError extends Error {}
class UsageError extends Error {}

function fail(message: string): never {
  throw new IngestError(message);
}

// Synchronous writes keep the output complete when process.exit() runs.
function write(fd: number, text: string): void {
  let buffer = Buffer.from(text);

  while (buffer.length > 0) {
    try {
      buffer = buffer.subarray(fs.writeSync(fd, buffer));
    } catch (error) {
      if ((error as NodeJS.ErrnoException).code !== "EAGAIN") throw error;
    }
  }
}

function print(line = ""): void {
  write(1, `${line}\n`);
}

function compare(left: string, right: string): number {
  return left < right ? -1 : left > right ? 1 : 0;
}

function formatSize(size: number): string {
  let value = size;
  for (const unit of ["B", "KiB", "MiB", "GiB"]) {
    if (value < 1024) return `${value.toFixed(1)} ${unit}`;
    value /= 1024;
  }

  return `${value.toFixed(1)} TiB`;
}

function statPath(path: string, followLinks = true) {
  try {
    return followLinks ? fs.statSync(path) : fs.lstatSync(path);
  } catch {
    return undefined;
  }
}

const exists = (path: string) => statPath(path) !== undefined;
const isFile = (path: string) => statPath(path)?.isFile() ?? false;
const isDirectory = (path: string) => statPath(path)?.isDirectory() ?? false;

function defaultRoot(): string {
  return join(homedir(), "pictures", "photography");
}

function today(): string {
  const now = new Date();

  return [now.getFullYear(), now.getMonth() + 1, now.getDate()].map(part => String(part).padStart(2, "0")).join("-");
}

function helpText(): string {
  return `${USAGE}

Copy and verify every file from a camera supported by gphoto2.

arguments:
  slug               batch name: lowercase letters, digits and single hyphens

options:
  -h, --help         show this help and exit
  --date YYYY-MM-DD  ingestion date used in the destination path (default: today)
  --root ROOT        photography root (default: ${defaultRoot()})
  --dry-run          inspect the camera and destination without writing files
  --resume           resume an incomplete ingest after checking its files

Example: fuji-ingest --dry-run fuji-baseline
         fuji-ingest fuji-baseline
`;
}

function parseArguments(argv: string[]): Arguments | "help" {
  let parsed;
  try {
    parsed = parseArgs({
      args: argv,
      allowPositionals: true,
      options: {
        help: { type: "boolean", short: "h" },
        date: { type: "string" },
        root: { type: "string" },
        "dry-run": { type: "boolean" },
        resume: { type: "boolean" },
      },
    });
  } catch (error) {
    // Node's messages go on with advice about "--"; the first sentence is enough.
    throw new UsageError((error as Error).message.split(/\.\s/)[0]!);
  }

  const { values, positionals } = parsed;
  if (values.help) return "help";
  if (positionals.length === 0) throw new UsageError("missing batch slug");
  if (positionals.length > 1) throw new UsageError(`unexpected arguments: ${positionals.slice(1).join(" ")}`);

  const { date = today(), root = defaultRoot(), "dry-run": dryRun = false, resume = false } = values;

  return { slug: positionals[0]!, date, root, dryRun, resume };
}

// Accepts YYYY-MM-DD only and refuses impossible dates such as 2026-02-31.
function dateYear(text: string): string | undefined {
  const match = DATE_RE.exec(text);
  if (!match) return undefined;

  const [year, month, day] = match.slice(1).map(Number) as [number, number, number];
  const date = new Date(0);
  date.setUTCFullYear(year, month - 1, day);
  const valid = year >= 1 && date.getUTCFullYear() === year && date.getUTCMonth() === month - 1 && date.getUTCDate() === day;

  return valid ? match[1] : undefined;
}

function expandHome(path: string): string {
  return path === "~" || path.startsWith("~/") ? homedir() + path.slice(1) : path;
}

// Ctrl+C
//
// The SIGINT handler stops gphoto2 with SIGTERM, then SIGKILL after 5 s, and
// exits 130. settle() parks the main flow meanwhile, so the child's exit
// cannot be reported as a download failure.

let activeChild: Subprocess | undefined;
let interrupted = false;

function running(child: Subprocess): boolean {
  return child.exitCode === null && child.signalCode === null;
}

async function exitsWithin(child: Subprocess, milliseconds: number): Promise<boolean> {
  return Promise.race([child.exited.then(() => true), Bun.sleep(milliseconds).then(() => false)]);
}

async function interrupt(): Promise<void> {
  if (interrupted) return;
  interrupted = true;

  const child = activeChild;
  if (child && running(child)) {
    child.kill("SIGTERM");
    if (!(await exitsWithin(child, 5000))) child.kill("SIGKILL");
    await child.exited;
  }

  write(2, "\nfuji-ingest: interrupted; camera files were not deleted\n");
  process.exit(130);
}

async function settle<T>(promise: Promise<T>): Promise<T> {
  const value = await promise;
  if (interrupted) await new Promise(() => {});

  return value;
}

function commandEnvironment(): Record<string, string | undefined> {
  return { ...process.env, LC_ALL: "C" };
}

async function runCapture(args: string[]): Promise<string> {
  const child = Bun.spawn(args, { env: commandEnvironment(), stdin: "inherit", stdout: "pipe", stderr: "pipe" });
  activeChild = child;

  const [stdout, stderr, exitCode] = await settle(
    Promise.all([new Response(child.stdout).text(), new Response(child.stderr).text(), child.exited]),
  );
  activeChild = undefined;

  if (exitCode !== 0) {
    const details = stderr.trim() || stdout.trim() || "unknown error";
    fail(`${args.join(" ")} failed:\n${details}`);
  }

  return stdout;
}

async function detectCamera(): Promise<string> {
  const output = await runCapture(["gphoto2", "--auto-detect"]);
  const devices = output
    .split("\n")
    .filter(line => line.includes("usb:"))
    .map(line => line.trim());

  if (devices.length === 0) fail("gphoto2 did not detect a camera. Connect and power on the Fuji, then retry.");
  if (devices.length > 1) fail("more than one camera was detected; disconnect the others and retry");

  return devices[0]!;
}

async function cameraInventory(): Promise<InventoryItem[]> {
  const output = await runCapture(["gphoto2", "--list-files"]);
  let folder = "/";
  const files: InventoryItem[] = [];

  for (const line of output.split("\n")) {
    const folderMatch = FOLDER_RE.exec(line);
    if (folderMatch) {
      folder = folderMatch[1]!;
      continue;
    }
    const fileMatch = FILE_RE.exec(line);
    if (fileMatch) files.push({ folder, name: fileMatch[1]!, size_kib: Number(fileMatch[2]) });
  }

  if (files.length === 0) fail("the camera contains no downloadable files");

  // Files land flat in the batch, so one name in two folders would overwrite.
  const counts = new Map<string, number>();
  for (const { name } of files) counts.set(name, (counts.get(name) ?? 0) + 1);
  const duplicates = [...counts].filter(([, count]) => count > 1).map(([name]) => name);
  if (duplicates.length > 0) {
    const sample = duplicates.sort().slice(0, 5).join(", ");
    fail(`the camera contains duplicate filenames in different folders (${sample}). A flat ingest would overwrite files.`);
  }

  return files.sort((a, b) => compare(a.folder, b.folder) || compare(a.name, b.name));
}

function freeSpace(root: string): number {
  let directory = root;
  while (!exists(directory) && directory !== dirname(directory)) directory = dirname(directory);
  const stats = fs.statfsSync(directory);

  return stats.bavail * stats.bsize;
}

// Sorted keys, as the Python version wrote them. The temporary file is
// private and renamed over the manifest, so a crash never leaves half a file.
function writeManifest(path: string, manifest: Manifest): void {
  const sorted = Object.fromEntries(Object.entries(manifest).sort(([a], [b]) => compare(a, b)));
  const temporary = `${path}.tmp`;

  fs.writeFileSync(temporary, `${JSON.stringify(sorted, null, 2)}\n`, { mode: 0o600 });
  fs.renameSync(temporary, path);
}

function loadManifest(path: string): Manifest {
  let value: unknown;
  try {
    value = JSON.parse(fs.readFileSync(path, "utf8"));
  } catch (error) {
    fail(`could not read the incomplete ingest manifest ${path}: ${(error as Error).message}`);
  }
  if (typeof value !== "object" || value === null || Array.isArray(value)) {
    fail(`could not read the incomplete ingest manifest ${path}: expected a JSON object`);
  }

  return value as Manifest;
}

// A file that vanished since the listing counts as a mismatch.
function sizeMatches(path: string, expectedKib: number): boolean {
  const size = statPath(path)?.size;

  return size !== undefined && Math.abs(size / 1024 - expectedKib) <= SIZE_TOLERANCE_KIB;
}

// Every regular file under the batch except the control files. Symlinked
// directories are not followed. Entries that vanish while gphoto2 writes
// are skipped.
function localFiles(batch: string): string[] {
  const files: string[] = [];
  const visit = (directory: string): void => {
    let names: string[] = [];
    try {
      names = fs.readdirSync(directory);
    } catch {
      return;
    }

    for (const name of names) {
      const path = join(directory, name);
      if (statPath(path, false)?.isDirectory()) visit(path);
      else if (isFile(path) && !CONTROL_NAMES.has(name)) files.push(path);
    }
  };

  visit(batch);

  return files.sort();
}

function prepareResume(batch: string, inventory: InventoryItem[]): Manifest {
  const manifestPath = join(batch, MANIFEST_NAME);
  if (!isFile(manifestPath)) fail(`cannot resume: ${manifestPath} does not exist`);

  const manifest = loadManifest(manifestPath);
  if (manifest.status !== "incomplete") {
    fail(`cannot resume an ingest with status ${JSON.stringify(manifest.status ?? null)}`);
  }
  // Both versions store inventory items with the keys folder, name, size_kib.
  if (JSON.stringify(manifest.inventory) !== JSON.stringify(inventory)) {
    fail("the camera contents changed since the interrupted ingest; refusing to resume");
  }

  const expected = new Map(inventory.map(item => [item.name, item]));
  const seen = new Set<string>();
  for (const path of localFiles(batch)) {
    const name = basename(path);
    if (seen.has(name)) fail(`duplicate local filename while resuming: ${name}`);
    seen.add(name);

    const item = expected.get(name);
    if (!item) fail(`unexpected file in incomplete ingest: ${path}`);
    if (!sizeMatches(path, item.size_kib)) {
      print(`Removing incomplete file before resume: ${name}`);
      fs.unlinkSync(path);
    }
  }

  return manifest;
}

function completedDownloadCount(batch: string, expected: Map<string, InventoryItem>): number {
  return localFiles(batch).filter(path => {
    const item = expected.get(basename(path));

    return item !== undefined && sizeMatches(path, item.size_kib);
  }).length;
}

function renderProgress(completed: number, total: number, previousWidth: number): number {
  const message = `Downloading: ${completed}/${total} files (${Math.round((completed / total) * 100)}%)`;
  write(1, `\r${message}${" ".repeat(Math.max(0, previousWidth - message.length))}`);

  return message.length;
}

// gphoto2 writes both streams to a temporary file, in order and without the
// risk of blocking on a full pipe.
async function download(command: string[], batch: string, inventory: InventoryItem[]): Promise<{ ok: boolean; output: string }> {
  const expected = new Map(inventory.map(item => [item.name, item]));
  const logDirectory = fs.mkdtempSync(join(tmpdir(), "fuji-ingest-"));
  const log = join(logDirectory, "gphoto2.log");
  const fd = fs.openSync(log, "w", 0o600);
  let previousWidth = 0;
  let lastCompleted = -1;

  try {
    const child = Bun.spawn(command, { cwd: batch, env: commandEnvironment(), stdin: "inherit", stdout: fd, stderr: fd });
    activeChild = child;

    // One last count after gphoto2 exits, so the line ends on the final state.
    for (let exited = false; !exited; ) {
      exited = !running(child);
      const completed = completedDownloadCount(batch, expected);
      if (completed !== lastCompleted) previousWidth = renderProgress(completed, inventory.length, previousWidth);
      lastCompleted = completed;
      if (!exited) await settle(Promise.race([child.exited, Bun.sleep(POLL_MS)]));
    }
    await settle(child.exited);
    activeChild = undefined;
    write(1, "\n");

    return { ok: child.exitCode === 0, output: fs.readFileSync(log, "utf8").trim() };
  } finally {
    fs.closeSync(fd);
    fs.rmSync(logDirectory, { recursive: true });
  }
}

function verify(batch: string, inventory: InventoryItem[]): string[] {
  const expected = new Map(inventory.map(item => [item.name, item]));
  const actual = new Map<string, string>();
  for (const path of localFiles(batch)) {
    const name = basename(path);
    if (actual.has(name)) fail(`download produced duplicate filename: ${name}`);
    actual.set(name, path);
  }

  const missing = [...expected.keys()].filter(name => !actual.has(name));
  const unexpected = [...actual.keys()].filter(name => !expected.has(name));
  const wrongSize = [...actual]
    .filter(([name, path]) => expected.has(name) && !sizeMatches(path, expected.get(name)!.size_kib))
    .map(([name]) => name);
  const problems = Object.entries({ missing, unexpected, "wrong size": wrongSize })
    .filter(([, names]) => names.length > 0)
    .map(([label, names]) => `${label}: ${names.sort().slice(0, 10).join(", ")}`);
  if (problems.length > 0) fail(`download verification failed:\n${problems.join("\n")}`);

  return [...actual.keys()].sort().map(name => actual.get(name)!);
}

// Bun.file().stream() reads the file in chunks, never whole.
async function sha256(path: string): Promise<string> {
  const digest = createHash("sha256");
  for await (const chunk of Bun.file(path).stream()) digest.update(chunk);

  return digest.digest("hex");
}

async function writeChecksums(batch: string, files: string[]): Promise<void> {
  const checksumPath = join(batch, CHECKSUM_NAME);
  const temporary = `${checksumPath}.tmp`;
  const fd = fs.openSync(temporary, "w");

  try {
    for (const [index, path] of files.entries()) {
      write(fd, `${await sha256(path)}  ${relative(batch, path)}\n`);
      const done = index + 1;
      if (done % 100 === 0 || done === files.length) print(`Checksummed ${done}/${files.length} files`);
    }
  } finally {
    fs.closeSync(fd);
  }
  fs.renameSync(temporary, checksumPath);
}

async function main(args: Arguments): Promise<number> {
  if (!SLUG_RE.test(args.slug)) fail("slug must contain lowercase letters, numbers and single hyphens only");
  const year = dateYear(args.date);
  if (!year) fail(`invalid date: ${args.date}; expected YYYY-MM-DD`);
  if (!Bun.which("gphoto2")) fail("gphoto2 is not installed. On Arch, install the gphoto2 package.");

  // Batches started under the old imported/ layout are resumed where they are.
  const root = resolve(expandHome(args.root));
  const batchName = `${args.date}-${args.slug}`;
  const legacyBatch = join(root, "imported", year, batchName);
  let batch = join(root, year, batchName);
  if (args.resume && !exists(batch) && isDirectory(legacyBatch)) batch = legacyBatch;
  const manifestPath = join(batch, MANIFEST_NAME);

  print(`Camera: ${await detectCamera()}`);
  print("Reading camera inventory…");
  const inventory = await cameraInventory();
  const totalBytes = inventory.reduce((sum, item) => sum + item.size_kib, 0) * 1024;
  const types = new Map<string, number>();
  for (const { name } of inventory) {
    const type = extname(name).toUpperCase() || "(none)";
    types.set(type, (types.get(type) ?? 0) + 1);
  }
  const free = freeSpace(root);
  const reserve = Math.max(1024 ** 3, Math.trunc(totalBytes * 0.05));

  print(`Imported destination: ${batch}`);
  print(`Camera files: ${inventory.length} (${formatSize(totalBytes)})`);
  print(`Types: ${[...types].sort(([a], [b]) => compare(a, b)).map(([type, count]) => `${type} ${count}`).join(", ")}`);
  print(`Free space: ${formatSize(free)}`);
  if (free < totalBytes + reserve) {
    fail(`not enough free space; need ${formatSize(totalBytes + reserve)} including safety margin`);
  }

  if (args.dryRun) {
    print("Dry run complete. No files or directories were created.");
    return 0;
  }

  let manifest: Manifest;
  if (args.resume) {
    if (!isDirectory(batch)) fail(`cannot resume: ${batch} does not exist`);
    manifest = prepareResume(batch, inventory);
  } else {
    const existing = [batch, legacyBatch].find(exists);
    if (existing) fail(`destination already exists: ${existing}`);
    fs.mkdirSync(batch, { recursive: true });
    manifest = {
      camera: await detectCamera(),
      created_at: new Date().toISOString(),
      destination: batch,
      inventory,
      status: "incomplete",
    };
    writeManifest(manifestPath, manifest);
  }

  print("Camera files will be copied without deleting them from the camera.");
  const command = ["gphoto2", "--quiet", "--recurse", "--get-all-files"];
  if (args.resume) command.push("--skip-existing");
  const result = await download(command, batch, inventory);
  if (!result.ok) {
    const details = result.output.split("\n").slice(-10).join("\n");
    fail(
      "gphoto2 download failed. The partial batch was kept. " +
        `Retry with: fuji-ingest --date ${args.date} --resume ${args.slug}` +
        (details ? `\ngphoto2 output:\n${details}` : ""),
    );
  }

  print("Verifying downloaded names and sizes…");
  const files = verify(batch, inventory);
  print("Writing SHA-256 manifest…");
  await writeChecksums(batch, files);

  writeManifest(manifestPath, {
    ...manifest,
    completed_at: new Date().toISOString(),
    sha256_manifest: CHECKSUM_NAME,
    status: "complete",
  });

  print();
  print(`Ingest complete: ${files.length} files in ${batch}`);
  print(`Checksums: ${join(batch, CHECKSUM_NAME)}`);
  print(`Add this directory to the darktable library: ${batch}`);
  print("Keep the camera card unchanged until a second copy has been verified.");

  return 0;
}

async function entry(): Promise<number> {
  process.on("SIGINT", () => void interrupt());

  try {
    const args = parseArguments(process.argv.slice(2));
    if (args === "help") {
      write(1, helpText());
      return 0;
    }

    return await main(args);
  } catch (error) {
    if (interrupted) await new Promise(() => {});
    if (error instanceof UsageError) {
      write(2, `${USAGE}\nfuji-ingest: error: ${error.message}\n`);
      return 2;
    }
    if (error instanceof IngestError) {
      write(2, `fuji-ingest: error: ${error.message}\n`);
      return 1;
    }
    throw error;
  }
}

process.exit(await entry());
