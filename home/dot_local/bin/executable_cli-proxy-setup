#!/usr/bin/env bun
// Prepare machine-local CLIProxyAPI files without logging in or starting services.

import { randomBytes } from "node:crypto";
import { chmodSync, closeSync, constants, existsSync, lstatSync, mkdirSync, openSync } from "node:fs";
import { readFileSync, renameSync, rmSync, statSync, writeFileSync } from "node:fs";
import { homedir } from "node:os";
import { basename, dirname, join } from "node:path";
import { parseArgs } from "node:util";

const PROVIDER = "claude-pro-proxy";
const USAGE = `usage: cli-proxy-setup [--refresh-config]

Prepare machine-local CLIProxyAPI files without logging in or starting services.

  --refresh-config  render the config again from the template, backing up the old one
  -h, --help        show this help
`;

const isObject = (value: unknown): value is Record<string, unknown> =>
  typeof value === "object" && value !== null && !Array.isArray(value);

// Refuse symlinks and unexpected types; a missing path is fine.
function requireType(path: string, type: "file" | "directory"): void {
  const stats = lstatSync(path, { throwIfNoEntry: false });
  if (stats && (type === "file" ? !stats.isFile() : !stats.isDirectory())) throw new Error(`Expected a ${type}`);
}

function privateDirectory(path: string): void {
  requireType(path, "directory");

  mkdirSync(dirname(path), { recursive: true });
  mkdirSync(path, { recursive: true, mode: 0o700 });
  chmodSync(path, 0o700);
}

// Replace a file atomically through a new temporary file with mode 0600.
function writePrivate(path: string, content: string | Buffer): void {
  requireType(path, "file");

  const temporary = join(dirname(path), `.cli-proxy-${randomBytes(6).toString("hex")}`);
  const flags = constants.O_WRONLY | constants.O_CREAT | constants.O_EXCL | constants.O_NOFOLLOW;
  try {
    const fd = openSync(temporary, flags, 0o600);
    try {
      writeFileSync(fd, content);
    } finally {
      closeSync(fd);
    }
    renameSync(temporary, path);
  } finally {
    rmSync(temporary, { force: true });
  }
}

function backup(path: string, root: string): void {
  const directory = join(root, "backups");
  privateDirectory(directory);

  writePrivate(join(directory, `${basename(path)}.${randomBytes(6).toString("hex")}`), readFileSync(path));
}

// Sort object keys so that key order does not matter when comparing.
const sortKeys = (_key: string, item: unknown) =>
  isObject(item) ? Object.fromEntries(Object.entries(item).sort(([a], [b]) => (a < b ? -1 : 1))) : item;

function prepare(home: string, managed: string, refresh: boolean): void {
  const root = join(home, ".local/share/cliproxyapi-opus-test");
  const keyPath = join(root, "proxy-key");
  const configPath = join(root, "config.native.yaml");
  const auth = join(root, "auth-native");
  const modelsPath = join(home, ".pi/agent/models.json");

  // Check everything before creating any machine-local state.
  for (const path of [keyPath, configPath, modelsPath]) requireType(path, "file");
  for (const path of [root, auth]) requireType(path, "directory");

  const provider: unknown = JSON.parse(readFileSync(join(managed, "pi-provider.json"), "utf8"));
  const models: unknown = existsSync(modelsPath) ? JSON.parse(readFileSync(modelsPath, "utf8")) : {};
  if (!isObject(models)) throw new Error("models.json must be an object");
  const providers = models.providers ?? {};
  if (!isObject(providers)) throw new Error("providers must be an object");
  const existing = Object.hasOwn(providers, PROVIDER) ? providers[PROVIDER] : null;
  const conflict = existing !== null && JSON.stringify(existing, sortKeys) !== JSON.stringify(provider, sortKeys);
  if (conflict) throw new Error("Conflicting provider");

  const template = readFileSync(join(managed, "config.template.yaml"), "utf8");
  for (const marker of ['"__LOCAL_PROXY_KEY__"', '"__AUTH_DIR__"']) {
    if (template.split(marker).length !== 2) throw new Error("Invalid template placeholders");
  }

  let key: string;
  if (existsSync(keyPath)) {
    if (statSync(keyPath).mode & 0o077) throw new Error("Local key is not private");
    key = readFileSync(keyPath, "utf8").trim();
    if (!/^[0-9a-f]{64}$/.test(key)) throw new Error("Unexpected local key format");
  } else if (existsSync(configPath)) {
    throw new Error("Config exists without its local key");
  } else {
    key = randomBytes(32).toString("hex");
  }

  privateDirectory(root);
  privateDirectory(auth);
  if (!existsSync(keyPath)) writePrivate(keyPath, `${key}\n`);

  // Replacer functions avoid the "$" patterns of String.replace.
  const rendered = template
    .replace('"__LOCAL_PROXY_KEY__"', () => JSON.stringify(key))
    .replace('"__AUTH_DIR__"', () => JSON.stringify(auth));
  if (!existsSync(configPath)) {
    writePrivate(configPath, rendered);
  } else if (refresh) {
    if (readFileSync(configPath, "utf8") !== rendered) {
      backup(configPath, root);
      writePrivate(configPath, rendered);
    }
  } else {
    console.log("Existing native config preserved. Use --refresh-config to render the managed template.");
  }

  if (existing === null) {
    if (existsSync(modelsPath)) backup(modelsPath, root);
    models.providers = { ...providers, [PROVIDER]: provider };
    mkdirSync(dirname(modelsPath), { recursive: true, mode: 0o700 });
    writePrivate(modelsPath, `${JSON.stringify(models, null, 2)}\n`);
  }

  console.log("Local proxy config and Pi provider ready. OAuth credentials were not copied or changed.");
  console.log("No service started. Log in locally, then enable cli-proxy-api.service.");
}

function main(): number {
  let values;
  try {
    ({ values } = parseArgs({
      args: process.argv.slice(2),
      options: { "refresh-config": { type: "boolean" }, help: { type: "boolean", short: "h" } },
    }));
  } catch {
    console.error("cli-proxy-setup: unknown argument. Run cli-proxy-setup --help.");
    return 2;
  }

  if (values.help) {
    process.stdout.write(USAGE);
    return 0;
  }

  const home = homedir();
  const managed = join(process.env.XDG_CONFIG_HOME || join(home, ".config"), "cli-proxy-api");

  try {
    prepare(home, managed, values["refresh-config"] ?? false);
  } catch {
    // Never print the error itself: it may contain file contents or credentials.
    console.error("cli-proxy-setup: preparation failed; existing credentials were not replaced.");
    console.error("Check file types, private key permissions, JSON, template placeholders and provider conflicts.");
    return 1;
  }

  return 0;
}

process.exitCode = main();
